# ── Supabase (Dashboard → Settings → API) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ── AI ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=            # luna(채팅·요약·추출), 임베딩
META_MODEL_API_KEY=        # Muse Voice Transcribe (https://dev.meta.ai)

# ── Google Calendar 연동 (로그인과 별도 OAuth 클라이언트) ───────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# ── 앱 ────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
ALLOWED_GOOGLE_EMAIL=      # 이 Gmail만 로그인 허용
CRON_SECRET=               # openssl rand -hex 32 · Supabase Vault 'rachel_cron_secret'와 동일 값
LLM_MONTHLY_BUDGET_USD=    # 선택. 비우면 경고 없이 비용 표시만
